FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/collector ./cmd/collector
COPY internal/collector ./internal/collector
COPY internal/protocol ./internal/protocol
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /collector ./cmd/collector

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /collector /collector
EXPOSE 8080
ENTRYPOINT ["/collector"]
